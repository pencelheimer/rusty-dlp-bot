RUSTY_DLP_BOT_TOKEN=your_token_here
RUSTY_DLP_LOG=warn,rusty_dlp_bot=info

RUSTY_DLP_MUSICLINK_API_KEY=your_key_here

# Optional: path to the TOML config file (default: config.toml in cwd)
# RUSTY_DLP_CONFIG_PATH=/etc/rusty-dlp-bot/config.toml

# Optional: paths to the binaries (default: looked up in PATH)
# RUSTY_DLP_YT_DLP=/usr/local/bin/yt-dlp
# RUSTY_DLP_FFMPEG=/usr/bin/ffmpeg

# Optional: shell command that updates yt-dlp, used on startup and by /update (default: updating is disabled)
# RUSTY_DLP_UPDATE_COMMAND=pip install --upgrade yt-dlp
