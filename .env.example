TELEGRAM_BOT_TOKEN=your_token_here
RUST_LOG=info

# Optional: path to a Netscape-format cookies file for authenticated downloads
# Export from your browser with a "Get cookies.txt" extension
YT_DLP_COOKIES=/path/to/cookies.txt

# Optional: path to an yt-dlp binary to use
YT_DLP_PATH=/path/to/yt-dlp
